{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // Autorise l'extension .ts dans un import. Necessaire au seul import
    // ./score.ts de seance.ts : les harnais de verif/ chargent les sources
    // directement avec Node, qui exige l'extension la ou un bundler la devine.
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["src"]
}
